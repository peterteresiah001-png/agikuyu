---
import Layout from "../layouts/Layout.astro";
import BookCover from "../components/BookCover.astro";
import { SITE } from "../data/site.js";
import { books } from "../data/books.js";

const featured = books.slice(0, 4);
const steps = ["Retrieve", "Re-evaluate", "Replenish", "Document", "Celebrate"];
---

<Layout title="Home" description="Agìkūyū Women & Men — retrieving, re-evaluating, replenishing, documenting and celebrating Agìkūyū history, heritage, culture and Gìkūyū language.">
  <section class="home-hero">
    <img class="hero-img" src="/images/ten.jpg" alt="" width="1600" height="900" />
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">{SITE.name}</p>
      <h1 class="hero-title">Retrieve. Re-evaluate. Replenish. Document. <em>Celebrate.</em></h1>
      <p class="hero-sub">Agìkūyū history, heritage, culture and Gìkūyū language.</p>
      <div class="hero-actions">
        <a href="/bookshop" class="btn-primary">Explore the Bookshop</a>
        <a href="/language" class="btn-outline">Learn Gìkūyū</a>
      </div>
    </div>
  </section>

  <section class="section-wrap">
    <div class="row reveal">
      <div>
        <div class="eyebrow">Who We Are</div>
        <h2 class="row-title">A cultural heritage initiative, <em>founded in 2017</em></h2>
        <p class="row-desc">
          Agìkūyū Women and Men is a cultural heritage initiative founded in 2017 and formally registered in 2018
          with a shared vision: to safeguard the wisdom, traditions, history, language and identity of the Agìkūyū people.
        </p>
        <p style="margin-top: 26px;"><a href="/about" class="btn-ghost">Read About Us</a></p>
      </div>
      <img src="/images/thirteen.jpg" alt="Archival photograph of three elders" width="700" height="520" loading="lazy" />
    </div>
  </section>

  <section class="section-wrap tight tinted">
    <div class="eyebrow center" style="justify-content:center;">Our Mission</div>
    <h2 class="section-title center">Five steps to <em>safeguard our heritage</em></h2>
    <ol class="steps-strip reveal">
      {steps.map((s, i) => (
        <li><span class="step-num">{String(i + 1).padStart(2, "0")}</span><span class="step-name">{s}</span></li>
      ))}
    </ol>
    <p class="section-sub center reveal" style="max-width: 720px;">
      Our mission is to Retrieve, Re-evaluate, Replenish, Document, and to Celebrate Agìkūyū culture, history,
      and Gìkūyū language so that current and future generations can understand, honor, and carry forward
      their heritage with pride.
    </p>
  </section>

  <section class="section-wrap">
    <div class="eyebrow center" style="justify-content:center;">Explore</div>
    <h2 class="section-title center">Ways to <em>engage with us</em></h2>
    <div class="grid-4" style="margin-top: 50px;">
      <article class="card plain reveal">
        <div class="card-body">
          <p class="card-tag">Bookshop</p>
          <h3 class="card-title">Bookshop</h3>
          <p class="card-desc">Books and publications that contribute to the preservation, study and enjoyment of Agìkūyū and African history, culture, language, religion, literature and indigenous knowledge.</p>
          <a href="/bookshop" class="btn-ghost card-cta">Visit the Bookshop</a>
        </div>
      </article>
      <article class="card plain reveal d1">
        <div class="card-body">
          <p class="card-tag">Research &amp; Heritage</p>
          <h3 class="card-title">Our Work</h3>
          <p class="card-desc">The research, documentation, knowledge-sharing, partnerships and cultural initiatives through which we advance our mission.</p>
          <a href="/our-work" class="btn-ghost card-cta">See Our Work</a>
        </div>
      </article>
      <article class="card plain reveal d2">
        <div class="card-body">
          <p class="card-tag">Language</p>
          <h3 class="card-title">Gìkūyū Language Initiative</h3>
          <p class="card-desc">Virtual Gìkūyū language classes for adults aged 20 years and above — a structured pathway from beginner to advanced proficiency.</p>
          <a href="/language" class="btn-ghost card-cta">Learn Gìkūyū</a>
        </div>
      </article>
      <article class="card plain reveal d3">
        <div class="card-body">
          <p class="card-tag">Get Involved</p>
          <h3 class="card-title">Partner With Us</h3>
          <p class="card-desc">Sponsor our research, donate, or partner with us in the work of preserving and advancing Agìkūyū heritage.</p>
          <a href="/partner" class="btn-ghost card-cta">Join the Journey</a>
        </div>
      </article>
    </div>
  </section>

  <section class="section-wrap tinted">
    <div class="eyebrow center" style="justify-content:center;">From the Bookshop</div>
    <h2 class="section-title center">Books that carry <em>memory and knowledge</em></h2>
    <div class="grid-4 books" style="margin-top: 50px;">
      {featured.map((book, i) => (
        <a class={`card book-card reveal ${i % 4 === 1 ? "d1" : i % 4 === 2 ? "d2" : i % 4 === 3 ? "d3" : ""}`} href={`/bookshop/${book.id}`}>
          <BookCover book={book} />
          <div class="card-body">
            <h3 class="card-title">{book.title}</h3>
            <p class="card-author">{book.author}</p>
            <p class="card-price">Ksh {book.price.toLocaleString("en-US")}</p>
          </div>
        </a>
      ))}
    </div>
    <p style="text-align:center; margin-top: 44px;"><a href="/bookshop" class="btn-primary">View All Books</a></p>
  </section>

  <section class="cta-strip">
    <p>Have a question, an idea, a research project or an opportunity to collaborate?<br />
      <a href="/contact">Send us a message</a> &middot; <a href={`tel:${SITE.phone}`}>{SITE.phone}</a> &middot; <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
  </section>
</Layout>
