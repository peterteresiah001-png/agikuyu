---
import Layout from "../layouts/Layout.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { books } from "../data/books.js";
---

<Layout title="Bookshop">
  <section data-section="bookshop-hero">
    <img src="https://picsum.photos/seed/bookshop-hero/1400/450" alt="Bookshop" width="1400" height="450" />
    <h1>Bookshop</h1>
    <p>
      Browse our titles below. This is an informational catalogue — there is no online checkout.
      Tap "Order via WhatsApp" on any book to message us directly and arrange purchase and delivery.
    </p>
  </section>

  <section data-section="book-grid">
    <div data-grid="books">
      {books.map((book) => (
        <article data-book-id={book.id}>
          <img src={book.image} alt={book.title} width="600" height="800" loading="lazy" />
          <p data-tag>{book.category}</p>
          <h3>{book.title}</h3>
          <p>{book.description}</p>
          <p data-price>Ksh {book.price.toLocaleString()}</p>
          <WhatsAppButton
            label="Order via WhatsApp"
            message={`Hi! I'm interested in buying "${book.title}" (Ksh ${book.price.toLocaleString()}). Is it available?`}
          />
        </article>
      ))}
    </div>
  </section>
</Layout>
