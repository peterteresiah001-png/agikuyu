---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../data/site.js";
---

<Layout title="Contact">
  <section class="page-hero">
    <img class="hero-img" src="/images/seven.jpg" alt="Contact us" width="1600" height="700" />
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">Get In Touch</p>
      <h1 class="hero-title">Contact <em>Us</em></h1>
    </div>
  </section>

  <section class="section-wrap tight">
    <div class="contact-grid">
      <a href={`tel:${SITE.phone}`} class="contact-tile reveal">
        <span class="contact-label">Phone</span>
        <span class="contact-detail">{SITE.phone}</span>
      </a>
      <a href={`mailto:${SITE.email}`} class="contact-tile reveal d1">
        <span class="contact-label">Email</span>
        <span class="contact-detail">{SITE.email}</span>
      </a>
      <div class="contact-tile reveal d2">
        <span class="contact-label">Location</span>
        <span class="contact-detail">{SITE.location}</span>
      </div>
    </div>
  </section>

  <section class="section-wrap tight" style="background: var(--bg-parchment);">
    <div class="eyebrow center" style="justify-content:center;">Message Us</div>
    <h2 class="section-title center">Send Us <em>a Message</em></h2>
    <div class="form-card reveal" style="margin-top: 44px;">
      <form data-form="contact">
        <label>
          Name
          <input type="text" name="name" required />
        </label>
        <label>
          Email
          <input type="email" name="email" required />
        </label>
        <label>
          Message
          <textarea name="message" rows="4" required></textarea>
        </label>
        <button type="submit">Send via WhatsApp</button>
      </form>
    </div>
  </section>
</Layout>

<script>
  import { whatsappLink } from "../data/site.js";

  const form = document.querySelector('form[data-form="contact"]');
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form as HTMLFormElement);
    const name = data.get("name");
    const email = data.get("email");
    const message = data.get("message");

    const text = `Contact Form Message\nName: ${name}\nEmail: ${email}\nMessage: ${message}`;
    window.open(whatsappLink(text), "_blank");
  });
</script>
