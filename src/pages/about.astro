---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About Us">
  <section data-section="about-hero">
    <img src="https://picsum.photos/seed/about-hero/1400/500" alt="Agĩkũyũ community" width="1400" height="500" />
    <h1>Who We Are</h1>
  </section>

  <section data-section="mission">
    <div>
      <h2>Our Mission</h2>
      <p>
        Agĩkũyũ Women and Men exists to preserve and promote Agĩkũyũ culture, language and identity —
        for the people living it today and the generations who will inherit it tomorrow.
      </p>
    </div>
    <img src="https://picsum.photos/seed/about-mission/700/500" alt="Mission" width="700" height="500" />
  </section>

  <section data-section="vision">
    <img src="https://picsum.photos/seed/about-vision/700/500" alt="Vision" width="700" height="500" />
    <div>
      <h2>Our Vision</h2>
      <p>
        A thriving Agĩkũyũ community where language, stories, and traditions are actively lived,
        taught, and celebrated — not just remembered.
      </p>
    </div>
  </section>

  <section data-section="values">
    <h2>What We Value</h2>
    <div data-grid="values">
      <article>
        <img src="https://picsum.photos/seed/value-1/400/300" alt="Heritage" width="400" height="300" />
        <h3>Heritage</h3>
        <p>Honouring the history, wisdom and practices passed down through generations.</p>
      </article>
      <article>
        <img src="https://picsum.photos/seed/value-2/400/300" alt="Language" width="400" height="300" />
        <h3>Language</h3>
        <p>Keeping Gĩkũyũ alive as a living, spoken, and taught language.</p>
      </article>
      <article>
        <img src="https://picsum.photos/seed/value-3/400/300" alt="Community" width="400" height="300" />
        <h3>Community</h3>
        <p>Bringing women, men, youth and children together around shared identity.</p>
      </article>
    </div>
  </section>
</Layout>
