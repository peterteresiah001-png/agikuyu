---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About Us">
  <section class="page-hero">
    <img class="hero-img" src="/images/sixteen.jpg" alt="Agĩkũyũ community" width="1600" height="700" />
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">About Us</p>
      <h1 class="hero-title">Who <em>We Are</em></h1>
    </div>
  </section>

  <section class="section-wrap">
    <div class="row-list">
      <div class="row reveal">
        <div>
          <div class="eyebrow">Our Mission</div>
          <h2 class="row-title">Preserving what makes us <em>who we are</em></h2>
          <p class="row-desc">
            Agĩkũyũ Women and Men exists to preserve and promote Agĩkũyũ culture, language and identity —
            for the people living it today and the generations who will inherit it tomorrow.
          </p>
        </div>
        <img src="/images/one.jpg" alt="Mission" width="700" height="520" loading="lazy" />
      </div>

      <div class="row reversed reveal">
        <div>
          <div class="eyebrow">Our Vision</div>
          <h2 class="row-title">A culture <em>lived</em>, not just remembered</h2>
          <p class="row-desc">
            A thriving Agĩkũyũ community where language, stories, and traditions are actively lived,
            taught, and celebrated — not just remembered.
          </p>
        </div>
        <img src="/images/two.jpg" alt="Vision" width="700" height="520" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section-wrap" style="background: var(--bg-parchment);">
    <div class="eyebrow center" style="justify-content:center;">What We Value</div>
    <h2 class="section-title center">The principles that <em>guide us</em></h2>
    <div class="grid-3" style="margin-top: 50px;">
      <article class="card reveal">
        <img class="card-img" src="/images/three.jpg" alt="Heritage" width="500" height="375" loading="lazy" />
        <div class="card-body">
          <h3 class="card-title">Heritage</h3>
          <p class="card-desc">Honouring the history, wisdom and practices passed down through generations.</p>
        </div>
      </article>
      <article class="card reveal d1">
        <img class="card-img" src="/images/four.jpg" alt="Language" width="500" height="375" loading="lazy" />
        <div class="card-body">
          <h3 class="card-title">Language</h3>
          <p class="card-desc">Keeping Gĩkũyũ alive as a living, spoken, and taught language.</p>
        </div>
      </article>
      <article class="card reveal d2">
        <img class="card-img" src="/images/five.jpg" alt="Community" width="500" height="375" loading="lazy" />
        <div class="card-body">
          <h3 class="card-title">Community</h3>
          <p class="card-desc">Bringing women, men, youth and children together around shared identity.</p>
        </div>
      </article>
    </div>
  </section>
</Layout>
